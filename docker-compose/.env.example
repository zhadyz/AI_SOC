# ============================================================================
# AI-SOC Docker Compose Environment
# ============================================================================
# Compose reads .env from THIS directory (docker-compose/), not the repo root.
#
# Setup:
#   1. Copy the full template:  cp ../.env.example ../.env
#   2. Edit ../.env credentials
#   3. Run deploy — scripts sync ../.env → docker-compose/.env automatically
#
# Or copy this file:  cp .env.example .env  (then merge secrets from ../.env.example)
# ============================================================================

# Compose project names (must match deploy-ai-soc.ps1 / deploy-ai-soc.sh)
COMPOSE_PROJECT_SIEM=ai-soc-siem
COMPOSE_PROJECT_AI=ai-soc-ai
COMPOSE_PROJECT_MONITORING=ai-soc-monitoring

# Shared SIEM networks (must match phase1-siem-core*.yml and ai-services.yml)
SIEM_BACKEND_NETWORK=ai-soc-siem-backend
SIEM_FRONTEND_NETWORK=ai-soc-siem-frontend

# Subnets — use 172.50/172.51 on Windows; 172.20/172.21 on Linux if no overlap errors
BACKEND_SUBNET=172.50.0.0/24
FRONTEND_SUBNET=172.51.0.0/24

# Wazuh (required for SIEM stack)
INDEXER_USERNAME=admin
INDEXER_PASSWORD=AisocIndexer1.dev
API_USERNAME=wazuh-wui
API_PASSWORD=AisocApiUser1-dev
WAZUH_API_PASSWORD=AisocApiUser1-dev

# AI services
POSTGRES_USER=aisoc
POSTGRES_PASSWORD=aisoc-postgres-dev
POSTGRES_DB=aisoc_metadata
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=AisocGrafana1-dev

# Ollama (reduce on 16GB RAM hosts, e.g. OLLAMA_MEMORY_LIMIT=4G)
OLLAMA_MEMORY_LIMIT=6G
